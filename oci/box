#!/usr/bin/env bash

# Strict Bash Mode
set -euo pipefail

here="${BASH_SOURCE[0]%/*}"
source "$here/../shared/functions.sh"

read_box box.env
read_location "${oci_location:-$location}"
read_instance "${oci_instance:-$instance}"
read_box box.env # allow box to override defaults

oci_config_file="${oci_config_file:-}"
oci_config_file="${oci_config_file/\~/$HOME}"
oci_config_file="${oci_config_file/\$HOME/$HOME}"

source "$here/use" "${oci_config:-DEFAULT}" "${oci_config_file}"

loud green printf "\n[%s:%s]\n...\n" "${oci_config_file:-~/.oci/config}" "${oci_config:-DEFAULT}"
loud cyan echo "TENANCY=${TENANCY}$NL..."
